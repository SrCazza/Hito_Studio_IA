# ─────────────────────────────────────────────────────────────
# Studio de Contenido IA — variables de entorno
# Copia este archivo a .env.local y rellena los valores.
# NUNCA commitees .env.local ni claves reales. (Ver guardrail #6 en CLAUDE.md)
# ─────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
# URL del proyecto y claves. La anon key es pública (segura para el cliente);
# la service_role_key salta RLS y SOLO va en rutas de servidor y en n8n.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # solo servidor / n8n — jamás en el cliente

# Conexión directa (migraciones / CLI). Desde Vercel serverless usa el pooler.
SUPABASE_DB_URL=                    # pooler (Supavisor), modo transaction, puerto 6543

# ── Modelos / APIs de pago ────────────────────────────────────
ANTHROPIC_API_KEY=                  # Claude (Sonnet juicio / Haiku volumen)
FAL_API_KEY=                        # fal.ai — imagen (image-to-image)
ELEVENLABS_API_KEY=                 # voz (raro)
OPENAI_API_KEY=                     # opcional (A/B)

# ── n8n (motor / worker) ──────────────────────────────────────
N8N_WEBHOOK_URL=                    # URL del webhook del Producer en n8n
N8N_WEBHOOK_SECRET=                 # secreto compartido Vercel <-> n8n (auth del callback)

# ── App ───────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000  # en prod: la URL de Vercel

# ── Topes de costo (override en DB/config si hace falta) ──────
DEFAULT_BUDGET_CAP_USD=25           # tope por tanda por defecto

# ── Sociales (más adelante — M8) ──────────────────────────────
# META_APP_ID=
# META_APP_SECRET=
# TIKTOK_CLIENT_KEY=
